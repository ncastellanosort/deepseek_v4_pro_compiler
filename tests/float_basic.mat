print("=== float/double ===");

float x = 3.14;
print(x);

double y = 2.5;
print(y);

print("=== float arith ===");
float a = 1.5;
float b = 2.5;
float c = a + b;
print(c);

float d = a * b;
print(d);

print("=== cast int to float ===");
float fi = (float)5;
print(fi);

double di = (double)10;
print(di);

print("=== cast float to int ===");
int ix = (int)3.14;
print(ix);

print("=== mixed arithmetic ===");
double mx = 2.0 + 3;
print(mx);

print("=== neg float ===");
double neg = -2.5;
print(neg);

print("=== float division ===");
double dv = 10.0 / 4.0;
print(dv);
