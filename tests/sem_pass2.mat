/* func mode with recursion and mutual calls */
def foo(x) {
    return x + 1;
}

def bar(a, b) {
    return a + baz(b);
}

def baz(n) {
    if (n <= 0) { return 0; }
    return n + baz(n - 1);
}

def factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

def main() {
    print(factorial(5));
    print(foo(10));
    print(bar(1, 5));
}
